# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to Git (it's already in .gitignore).

# --- Database ---
# If using Docker Compose (recommended), leave this as-is.
DATABASE_URL=postgresql://ocrdocflow_user:changeme_password@db:5432/ocrdocflow

# --- Security ---
# Generate a random secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_ME_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploaded_files
