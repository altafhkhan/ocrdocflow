# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to Git (it's already in .gitignore).

# --- Database ---
# If using Docker Compose (recommended), leave this as-is.
DATABASE_URL=postgresql://ocrdocflow_user:changeme_password@db:5432/ocrdocflow

# --- Security ---
# Generate a random secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_ME_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email (password reset links) ---
# Option 1 - your own mailbox over SMTP (used when SMTP_HOST is set).
# Port 465 = SSL, 587 or 26 = STARTTLS. MAIL_FROM must be that mailbox.
# (The production droplet can only reach port 26 - see deploy/DEPLOY.md.)
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=auto
# Option 2 - Resend (https://resend.com), used when SMTP_HOST is empty.
# A sending-only key is enough; MAIL_FROM must be on a domain verified there.
RESEND_API_KEY=
# With neither option filled in, reset links are only written to the server log.
MAIL_FROM=OCRDocFlow <no-reply@qumaxa.com>
PASSWORD_RESET_EXPIRE_MINUTES=30
# Public address of the web app, used to build the reset link.
FRONTEND_URL=http://localhost:5173

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploaded_files

# --- OCR engine ---
# gemini (default; Google AI Studio key) | paddle (local, offline) | azure
OCR_PROVIDER=gemini
OCR_FALLBACK_TO_PADDLE=true
# Documents processed at the same time; extra uploads queue up.
OCR_MAX_CONCURRENT=6

# --- AI cost monitoring, limits and caps (Admin Panel > Usage & costs) ---
# Where alert emails go when a customer or the platform passes 80% / 100%
# of its monthly AI spending cap. Empty = alerts only in the API log.
ALERT_EMAIL=
# Monthly AI spending cap for the whole platform in USD (0 = no cap).
# Reaching it pauses ALL uploads until next month or until it is raised.
PLATFORM_MONTHLY_COST_CAP_USD=0
# Default monthly AI spending cap per customer, by plan (USD, 0 = no cap).
# One customer can be given its own cap in the Admin Panel.
PLAN_COST_CAPS_USD=free:0.50,starter:6,professional:20,business:50
# Price list used to turn tokens into cost: model:input:output, USD per
# 1 million tokens. Update it when Google changes its prices.
AI_PRICES_USD_PER_MTOK=gemini-3.6-flash:0.75:3.75,gemini-3.5-flash:0.75:3.75,gemini-3.5-flash-lite:0.30:2.50,gemini-3.1-flash-lite:0.25:1.50
# A long invoice counts as one plan invoice per this many line items.
LINE_ITEMS_PER_INVOICE_UNIT=25
# Get a key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Azure AI Document Intelligence resource (free F0 tier), e.g.
# https://<name>.cognitiveservices.azure.com
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# --- Launch promotion (applied automatically at Stripe checkout) ---
PROMO_ENABLED=true
PROMO_NAME=Launch offer
PROMO_PERCENT_OFF=50
PROMO_MAX_REDEMPTIONS=50
# forever | once | repeating (then PROMO_DURATION_MONTHS applies)
PROMO_DURATION=forever
PROMO_DURATION_MONTHS=3
# optional end date, ISO format: PROMO_ENDS_AT=2026-12-31
PROMO_ENDS_AT=
