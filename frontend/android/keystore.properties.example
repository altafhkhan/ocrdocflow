# Copy this file to keystore.properties (same folder) and fill in your own
# values. keystore.properties and the .jks file are ignored by git - keep
# them, and a backup of them, somewhere safe. See deploy/MOBILE.md.
storeFile=ocrdocflow-upload.jks
storePassword=CHANGE_ME
keyAlias=ocrdocflow
# Leave keyPassword as it is (or delete the line) if the key uses the same
# password as the file - that is the normal case with keytool.
keyPassword=CHANGE_ME
